# Use a root .env file or environment variables. Never package credentials in the JAR.
TOKEN=your_discord_bot_token
MongoURI=mongodb://localhost:27017/GBF?replicaSet=rs0
# Optional: database name (default GBF, the production database). A test instance must use another name;
# start_test_server.bat reads .env.test instead of this file and refuses GBF (see "Test instance" in README.md).
# MONGO_DB_NAME=GBF_test

# Free-game alerts. The system stays off until both of these are set.
# Private channel where new giveaways wait for approval (Approve / Reject buttons).
FREEBIE_REVIEW_CHANNEL_ID=123456789012345678
# Who may approve, reject or stop alerts (comma-separated user IDs).
FREEBIE_OWNER_IDS=123456789012345678
# Optional: separate review channel for indie, console and mobile giveaways (defaults to the channel above).
# FREEBIE_OTHER_REVIEW_CHANNEL_ID=123456789012345678
# Optional: launchers posted without review (comma-separated ids; default epic,steam,gog; none = review all).
# FREEBIE_AUTO_SEND=epic,steam,gog
# Optional: GamerPower poll interval in minutes (5-120, default 10). FREEBIE_ENABLED=false turns everything off.
FREEBIE_POLL_MINUTES=10
# Optional: days finished alerts, offers and notice records are kept (30-3650, default 90; invalid values use 90).
FREEBIE_RETENTION_DAYS=90
# Optional: most users who may get personal free-game DMs (0-100000, default 100). 0 turns DM alerts off.
FREEBIE_DM_MAX_SUBSCRIBERS=100

# Mail bridge: forwards ChatGPT scheduled-task emails to Discord (see README, "Mail bridge").
# Leave the three GMAIL_ values empty to keep it off.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# MAIL_BRIDGE_CHANNEL_ID=1562067773033807912
# MAIL_BRIDGE_GUILD_ID=1043515676960247828
# MAIL_BRIDGE_MENTION_USER_ID=333644367539470337
# MAIL_BRIDGE_DIAGNOSTIC_CHANNEL_ID=
# MAIL_BRIDGE_QUERY=from:(openai.com OR chatgpt.com)
# MAIL_BRIDGE_SENDERS=openai.com,chatgpt.com
# MAIL_BRIDGE_PATTERNS_EEE_TRAINING=EEE Industrial Training Hunter
# MAIL_BRIDGE_PATTERNS_POWER_ELECTRONICS=Power Electronics Career Intelligence
# MAIL_BRIDGE_PATTERNS_RTL_VERIFICATION=RTL / Digital Verification Career Tracker
# MAIL_BRIDGE_POLL_MINUTES=5
# MAIL_BRIDGE_MAX_ATTEMPTS=6

# Epic release announcements (default true). false = rollback: new approvals post one message per game.
FREEBIE_GROUPED_ANNOUNCEMENTS=true
# EGData region and mobile-offer enrichment (default true). Failures only mean "not fully verified".
FREEBIE_EGDATA_ENABLED=true
# Automatic publishing to servers that Follow the hub's Announcement Channels (default false).
# Both lines are required. Convert the channels to Announcement Channels yourself; the bot needs View Channel,
# Send Messages, Embed Links and Read Message History there. Comma-separated channel IDs.
FREEBIE_PUBLISH_ENABLED=false
FREEBIE_PUBLISH_CHANNEL_IDS=
# Combined "Claim all PC games" checkout button (default false). Enable only after a signed-in preview is checked.
FREEBIE_EPIC_CHECKOUT=false
# Follow GamerPower claim redirects to merge duplicates automatically (default false; unverified endpoint).
FREEBIE_RESOLVE_GAMERPOWER_LINKS=false
